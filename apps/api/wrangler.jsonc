/**
 * aft.page Worker — deploy API + *.aft.page static serve.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aft-page-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ROOT_DOMAIN": "aft.page"
  },
  "kv_namespaces": [
    {
      "binding": "SITES",
      "id": "3bc4889e9e974a2bbb09433c8b932870"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "aft-page-sites"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aft-page",
      "database_id": "49430d21-12f7-44dd-bd74-fb649148b34c",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "aft_page_metrics"
    }
  ],
  "routes": [
    {
      "pattern": "api.aft.page",
      "custom_domain": true
    },
    {
      "pattern": "*.aft.page/*",
      "zone_name": "aft.page"
    }
  ]
}
