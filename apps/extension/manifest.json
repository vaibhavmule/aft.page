{
  "manifest_version": 3,
  "name": "aft.page — Deploy",
  "version": "0.4.5",
  "description": "One-click deploy for HTML from ChatGPT or Claude to a live *.aft.page URL.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.aft.page/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_title": "aft.page",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
