# DinD runner for Dockerfile plans only (Wave 3). Language stacks use ./Dockerfile.
# https://developers.cloudflare.com/sandbox/guides/docker-in-docker/
FROM docker:dind-rootless
USER root

# Match @cloudflare/sandbox package major; musl build for Alpine dind-rootless.
COPY --from=docker.io/cloudflare/sandbox:0.12.8-musl /container-server/sandbox /sandbox
COPY --from=docker.io/cloudflare/sandbox:0.12.8-musl /usr/lib/libstdc++.so.6 /usr/lib/libstdc++.so.6
COPY --from=docker.io/cloudflare/sandbox:0.12.8-musl /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1
COPY --from=docker.io/cloudflare/sandbox:0.12.8-musl /bin/bash /bin/bash
COPY --from=docker.io/cloudflare/sandbox:0.12.8-musl /usr/lib/libreadline.so.8 /usr/lib/libreadline.so.8
COPY --from=docker.io/cloudflare/sandbox:0.12.8-musl /usr/lib/libreadline.so.8.2 /usr/lib/libreadline.so.8.2

# musl DinD base has no /workspace; sandbox gitCheckout + file APIs expect it.
RUN mkdir -p /workspace && chmod 1777 /workspace

# iptables disabled (CF Containers); cgroupfs for production dockerd.
RUN printf '#!/bin/sh\n\
set -eu\n\
dockerd-entrypoint.sh dockerd --iptables=false --ip6tables=false --exec-opt native.cgroupdriver=cgroupfs &\n\
until docker version >/dev/null 2>&1; do sleep 0.2; done\n\
echo "Docker is ready"\n\
wait\n' > /home/rootless/boot-docker-for-dind.sh && chmod +x /home/rootless/boot-docker-for-dind.sh

ENTRYPOINT ["/sandbox"]
CMD ["/home/rootless/boot-docker-for-dind.sh"]
EXPOSE 8080
