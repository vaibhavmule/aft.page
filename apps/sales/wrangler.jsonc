/**
 * aft.page founder sales agent — Agents SDK chat + CRM-lite.
 * Auth: SALES_SECRET (cookie / Bearer). Not public.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aft-page-sales",
  "account_id": "44255ec64e0080b678670b53bf810d27",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SalesAgent",
        "class_name": "SalesAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SalesAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
